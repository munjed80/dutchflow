{
  "name": "dutchflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "content:check": "node scripts/check-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "audio:generate": "node scripts/generate-audio.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.4",
    "next": "16.3.5",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.19.12",
    "typescript": "^5.9.0"
  }
}
