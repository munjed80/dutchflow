# Set these only for offline audio generation. Never expose them to the browser.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Optional accounts. All five values are required; leave blank for guest-only mode.
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret with at least 32 characters; never use the E2E secret.
BETTER_AUTH_SECRET=
# Use smtps:// or SMTP with STARTTLS in production; URL-encode credentials.
SMTP_URL=
EMAIL_FROM=
# Only trust a header overwritten by your reverse proxy. Restrict direct origin access.
AUTH_IP_HEADER=x-real-ip
